# Copy this file to .env (read by Next.js and by the Prisma CLI) and fill in the values.
# Never commit .env: it is listed in .gitignore.

# PostgreSQL. DATABASE_URL is used by the app; DIRECT_URL by Prisma migrations
# (they can be the same URL with a local database).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/the_five_doors"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/the_five_doors"

# Public URL of the app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT secrets: two different values, each generated with `openssl rand -hex 64`.
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
